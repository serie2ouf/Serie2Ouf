{% extends 'base.html.twig' %}

{% block title %}Votre panier{% endblock %}

{% block body %}
<div class="table-responsive">
    <h3>Votre panier</h3>

    <table class="table table-bordered table-hover align-middle">
        <tr class="table-primary text-center">
            <th>Photo</th>
            <th>Référence</th>
            <th>Désignation</th>
            <th class="text-end">Prix</th>
            <th>Quantité</th>
            <th class="text-end">Montant</th>
            <th>Actions</th>
        </tr>

        {% for item in items %}
            <tr id="ligne{{ item.produit.id }}">
                <td class="text-center">
                    {% if item.produit.photo %}
                        <img src="{{ asset('images/produits/' ~ item.produit.photo) }}" width="40" alt="{{ item.produit.designation }}">
                    {% else %}
                        <img src="{{ asset('images/produits/INDISPONIBLE.jpg') }}" width="40" alt="Indisponible">
                    {% endif %}
                </td>
                <td class="text-center">{{ item.produit.id }}</td>
                <td>{{ item.produit.designation }}</td>
                <td class="text-end">{{ item.produit.prix }} €</td>
                <td class="text-center">
                    {# Bouton diminuer #}
                    <a class="btn btn-outline-danger btn-sm me-1" title="Diminuer" href="{{ path('app_panier_moins', {id: item.produit.id}) }}">
                        <i class="bi bi-dash-lg"></i>
                    </a>
                    <span class="fw-bold">{{ item.qte }}</span>
                    {# Bouton augmenter #}
                    <a class="btn btn-outline-success btn-sm ms-1" title="Augmenter" href="{{ path('app_panier_plus', {id: item.produit.id}) }}">
                        <i class="bi bi-plus-lg"></i>
                    </a>
                </td>
                <td class="text-end">{{ (item.produit.prix * item.qte)|number_format(2, ',', ' ') }} €</td>
                <td class="text-center">
                    {# Bouton supprimer #}
                    <a class="btn btn-outline-danger btn-sm" title="Supprimer l'article" href="{{ path('app_panier_remove', {id: item.produit.id}) }}">
                        <i class="bi bi-trash3-fill"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted">Votre panier est vide</td>
            </tr>
        {% endfor %}

        <tr class="table-success">
            <td colspan="5" class="text-end"><b>TOTAL</b></td>
            <td class="text-end"><b>{{ total|number_format(2, ',', ' ') }} €</b></td>
            <td></td>
        </tr>
    </table>

    <div class="mt-3">
        <a class="btn btn-success me-2" href="{{ path('app_produit_index') }}">
            <i class="bi bi-arrow-left"></i> Retour au catalogue
        </a>

        {% if items|length > 0 %}
            <a class="btn btn-outline-danger me-2" href="{{ path('app_panier_clear') }}">
                <i class="bi bi-trash"></i> Vider le panier
            </a>

            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <form method="post" action="{{ path('app_commande_add') }}" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('commande_add') }}">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-circle-fill"></i> Payer
                    </button>
                </form>
            {% else %}
                <a class="btn btn-warning" href="{{ path('app_login') }}">
                    <i class="bi bi-person"></i> Connectez-vous pour payer
                </a>
            {% endif %}
        {% endif %}
    </div>
</div>
<br><br>
{% endblock %}
