{% extends 'base.html.twig' %}

{% block title %}Modifier le mot de passe{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .user_card {
        width: 100%;
        max-width: 420px;
        background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        border-radius: 16px;
        padding: 45px 25px 25px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
        position: relative;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .user_card:hover {
        box-shadow: 0 20px 50px rgba(34, 197, 94, 0.12);
        border-color: #22c55e;
    }

    .brand_logo_container {
        position: absolute;
        top: -50px;
        left: 50%;
        transform: translateX(-50%);
        height: 100px;
        width: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 8px 24px rgba(34, 197, 94, 0.3);
        border: 4px solid white;
        transition: all 0.3s ease;
    }

    .user_card:hover .brand_logo_container {
        transform: translateX(-50%) translateY(-3px);
        box-shadow: 0 12px 32px rgba(34, 197, 94, 0.4);
    }

    .brand_logo {
        height: 85px;
        width: 85px;
        border-radius: 50%;
        border: 2px solid white;
        object-fit: cover;
    }

    .form_container {
        background: transparent;
    }

    .conn-title {
        color: #22c55e;
        font-weight: 700;
        font-size: 1.3rem;
    }

    .input-icon {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        border: none !important;
        color: white;
    }

    .conn-input {
        border: 1px solid #e2e8f0 !important;
        padding: 0.6rem !important;
        transition: all 0.3s ease;
    }

    .conn-input:focus {
        border-color: #22c55e !important;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.1) !important;
    }

    .input-group-text.input-icon {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 0;
        padding-bottom: 0;
        border-radius: 0.375rem 0 0 0.375rem;
    }

    .input-group-text.input-icon .bi {
        font-size: 1.1rem;
        vertical-align: middle;
    }

    .input-group .form-control,
    .input-group-text.input-icon,
    .toggle-password-btn {
        height: calc(2.5rem + 2px);
    }

    .toggle-password-btn {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        border: none;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .toggle-password-btn:hover {
        transform: scale(1.05);
    }

    .btn-connect {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        font-weight: 700;
        padding: 0.6rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
        cursor: pointer;
    }

    .btn-connect:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(34, 197, 94, 0.4);
    }

    .conn-nav-link {
        color: #22c55e;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .conn-nav-link:hover {
        color: #16a34a;
    }

    .conn-footer-text {
        border-top: 1px solid #e2e8f0;
        padding-top: 1rem;
        font-size: 0.85rem;
        color: #64748b;
    }

    .btn-submit {
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        font-weight: 700;
        padding: 0.6rem;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
    }

    .btn-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(34, 197, 94, 0.4);
        color: white;
    }

    .btn-submit:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .password-checklist {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.85rem;
        color: #64748b;
    }

    .password-checklist li {
        margin-bottom: 4px;
    }

    .password-checklist li.valid {
        color: #22c55e;
    }

    .password-checklist li.valid i {
        color: #22c55e;
    }

    @media (max-width: 600px) {
        .user_card {
            width: 95%;
            max-width: 100%;
            padding: 45px 18px 18px;
        }

        .brand_logo_container {
            width: 90px;
            height: 90px;
            top: -45px;
        }

        .brand_logo {
            width: 75px;
            height: 75px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-center">
        <div class="user_card position-relative">

            <div class="brand_logo_container">
                <img src="{{ asset('images/divers/accueil.png') }}" class="brand_logo" alt="Logo Electric Mobility">
            </div>

            <div class="form_container mt-2">

                {{ form_start(form, {'attr': {'class': 'px-5'}}) }}

                <h3 class="text-center mb-3 conn-title">
                    <i class="bi bi-shield-lock"></i> Modifier le mot de passe
                </h3>

                {# Mot de passe actuel #}
                <label class="form-label fw-bold small">Mot de passe actuel</label>
                <div class="input-group mb-3">
                    <span class="input-group-text input-icon"><i class="bi bi-lock"></i></span>
                    {{ form_widget(form.passwordActuel, {'attr': {
                        'class': 'form-control conn-input',
                        'placeholder': 'Mot de passe actuel'
                    }}) }}
                    <button class="btn toggle-password-btn" type="button"
                        onclick="togglePassword('{{ form.passwordActuel.vars.id }}', 'eye1')">
                        <i id="eye1" class="bi bi-eye"></i>
                    </button>
                </div>
                {{ form_errors(form.passwordActuel) }}

                {# Nouveau mot de passe #}
                <label class="form-label fw-bold small">Nouveau mot de passe</label>
                <div class="input-group mb-2">
                    <span class="input-group-text input-icon"><i class="bi bi-lock"></i></span>
                    {{ form_widget(form.plainPassword.first, {'attr': {
                        'class': 'form-control conn-input',
                        'placeholder': 'Nouveau mot de passe'
                    }}) }}
                    <button class="btn toggle-password-btn" type="button"
                        onclick="togglePassword('{{ form.plainPassword.first.vars.id }}', 'eye2')">
                        <i id="eye2" class="bi bi-eye"></i>
                    </button>
                </div>
                {{ form_errors(form.plainPassword.first) }}

                {# Confirmation #}
                <label class="form-label fw-bold small">Confirmation</label>
                <div class="input-group mb-3">
                    <span class="input-group-text input-icon"><i class="bi bi-lock-fill"></i></span>
                    {{ form_widget(form.plainPassword.second, {'attr': {
                        'class': 'form-control conn-input',
                        'placeholder': 'Confirmer le mot de passe'
                    }}) }}
                    <button class="btn toggle-password-btn" type="button"
                        onclick="togglePassword('{{ form.plainPassword.second.vars.id }}', 'eye3')">
                        <i id="eye3" class="bi bi-eye"></i>
                    </button>
                </div>
                {{ form_errors(form.plainPassword.second) }}

                {# Checklist mot de passe #}
                <ul class="password-checklist mb-3" id="password-checklist">
                    <li><i class="bi bi-x-circle"></i> Une majuscule</li>
                    <li><i class="bi bi-x-circle"></i> Une minuscule</li>
                    <li><i class="bi bi-x-circle"></i> Un chiffre</li>
                    <li><i class="bi bi-x-circle"></i> Un caractère spécial</li>
                    <li><i class="bi bi-x-circle"></i> 10 caractères minimum</li>
                    <li><i class="bi bi-x-circle"></i> Les mots de passe sont identiques</li>
                </ul>

                <button type="submit" id="submitProfil" class="btn w-100 mb-3 btn-submit" disabled>
                    <i class="bi bi-check-lg me-2"></i> Enregistrer
                </button>

                <div class="conn-footer-text text-center">
                    <a href="{{ path('app_profil_index') }}" class="conn-nav-link">Annuler</a>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function togglePassword(inputId, eyeId) {
    const input = document.getElementById(inputId);
    const eye = document.getElementById(eyeId);
    if (!input || !eye) return;
    if (input.type === "password") {
        input.type = "text";
        eye.className = "bi bi-eye-slash";
    } else {
        input.type = "password";
        eye.className = "bi bi-eye";
    }
}

function passwordValidator(passwordId, confirmId, checklistId, submitId) {
    const password = document.getElementById(passwordId);
    const confirm  = document.getElementById(confirmId);
    const checklist = document.getElementById(checklistId);
    const submit   = document.getElementById(submitId);
    if (!password || !confirm || !checklist || !submit) return;

    const rules = [/[A-Z]/, /[a-z]/, /\d/, /[@$!%*?&#^(){}[\]\\]/, /.{10,}/];

    function update() {
        let allValid = true;
        const items = checklist.querySelectorAll("li");
        rules.forEach((rule, i) => {
            const ok = rule.test(password.value);
            items[i].classList.toggle("valid", ok);
            items[i].querySelector("i").className = ok ? "bi bi-check-circle" : "bi bi-x-circle";
            if (!ok) allValid = false;
        });
        const match = password.value && password.value === confirm.value;
        items[5].classList.toggle("valid", match);
        items[5].querySelector("i").className = match ? "bi bi-check-circle" : "bi bi-x-circle";
        submit.disabled = !(allValid && match);
    }

    password.addEventListener("input", update);
    confirm.addEventListener("input", update);
}

document.addEventListener("DOMContentLoaded", function () {
    passwordValidator(
        "{{ form.plainPassword.first.vars.id }}",
        "{{ form.plainPassword.second.vars.id }}",
        "password-checklist",
        "submitProfil"
    );
});
</script>
{% endblock %}
